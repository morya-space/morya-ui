{
  "name": "@well-insight/ui",
  "version": "0.1.5",
  "description": "Vue 3 component library for Well Insight.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/well-insight/well-insight-ui.git"
  },
  "homepage": "https://github.com/well-insight/well-insight-ui#readme",
  "bugs": {
    "url": "https://github.com/well-insight/well-insight-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./docs": "./src/docs/index.ts"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "prepare": "husky",
    "dev": "vite --config playground/vite.config.ts",
    "build:docs": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release": "node scripts/release.mjs",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:build": "node scripts/release.mjs build",
    "release:commit": "node scripts/release.mjs commit",
    "release:branch": "node scripts/release.mjs branch",
    "release:publish": "node scripts/release.mjs publish",
    "release:tag": "node scripts/release.mjs tag",
    "release:push": "node scripts/release.mjs push",
    "release:npm": "pnpm run release:build && pnpm run release:publish",
    "release:git": "node scripts/release-git.mjs --tag --branch",
    "release:mcp": "node scripts/release-mcp.mjs",
    "mcp:generate": "pnpm --filter @well-insight/ui-mcp generate",
    "mcp:build": "pnpm --filter @well-insight/ui-mcp build",
    "mcp:start": "pnpm --filter @well-insight/ui-mcp start"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-markdown-preview": "^1.1.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9"
  }
}
