{
  "name": "@morya-space/nuxt",
  "type": "module",
  "version": "0.2.0",
  "description": "Nuxt 3 module for morya-ui — styles, transpile, and client overlay context.",
  "license": "MIT",
  "homepage": "https://github.com/morya-space/morya-ui/tree/main/packages/nuxt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morya-space/morya-ui.git",
    "directory": "packages/nuxt"
  },
  "bugs": {
    "url": "https://github.com/morya-space/morya-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/module.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@nuxt/kit": "^3.16.0"
  },
  "peerDependencies": {
    "morya-ui": "^0.2.0",
    "nuxt": "^3.10.0"
  }
}
