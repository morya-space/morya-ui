{
  "name": "@morya-ui/mcp",
  "type": "module",
  "version": "0.1.1",
  "packageManager": "pnpm@10.12.4",
  "description": "MCP server for morya-ui — component docs, examples, and usage guidance for AI coding agents.",
  "license": "MIT",
  "homepage": "https://github.com/morya-space/morya-ui/tree/main/packages/ui-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morya-space/morya-ui.git",
    "directory": "packages/ui-mcp"
  },
  "bugs": {
    "url": "https://github.com/morya-space/morya-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": "./bin/morya-ui-mcp.js",
  "files": [
    "README.md",
    "bin",
    "data",
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "generate": "node ./scripts/generate-catalog.mjs",
    "check-catalog": "node ./scripts/generate-catalog.mjs --check",
    "validate-catalog": "node ./scripts/validate-catalog.mjs",
    "audit-example-coverage": "node ./scripts/audit-example-coverage.mjs",
    "write-example-coverage": "node ./scripts/audit-example-coverage.mjs --write",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "test": "vitest run --config ../../vitest.config.ts src/__tests__",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  }
}
