{
  "name": "@well-insight/ui-mcp",
  "type": "module",
  "version": "0.1.10",
  "packageManager": "pnpm@10.12.4",
  "description": "MCP server for @well-insight/ui — component docs, examples, and usage guidance for AI coding agents.",
  "license": "MIT",
  "homepage": "https://github.com/well-insight/well-insight-ui/tree/main/packages/ui-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/well-insight/well-insight-ui.git",
    "directory": "packages/ui-mcp"
  },
  "bugs": {
    "url": "https://github.com/well-insight/well-insight-ui/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "well-insight-ui-mcp": "./bin/well-insight-ui-mcp.js"
  },
  "files": [
    "README.md",
    "bin",
    "data",
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "generate": "node ./scripts/generate-catalog.mjs",
    "build": "pnpm run generate && tsc -p tsconfig.json",
    "start": "node ./dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  }
}
